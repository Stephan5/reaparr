# Copy to reaparr.conf and edit. One command-line argument per line
# (see ./reaparr.py --help). Passwords and API keys belong in the Keychain,
# not here; see README.
--port
9091
--user
YOUR_TRANSMISSION_USERNAME
# At least one of these is required; delete the one you don't use.
--sonarr-url
http://localhost:8989
--radarr-url
http://localhost:7878
